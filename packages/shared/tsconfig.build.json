{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The API is CommonJS (`node dist/src/main.js`), so the emitted output has
    // to be requireable. Next.js consumes CommonJS without complaint, whereas
    // ESM here would leave the API unable to load the package at all.
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
