# ============================================================
# AI PORTFOLIO — ENVIRONMENT CONFIGURATION
# Copy to .env and fill in the values.
# ============================================================

# ---- Core ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- PostgreSQL + pgvector ----
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=ai_portfolio
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/ai_portfolio?schema=public

# ---- Redis (BullMQ + cache) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=change-me-in-production-super-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@ashishpokhrel.dev
ADMIN_PASSWORD=change-me

# ---- Google Gemini ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LLM_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# ---- RAG tuning ----
RAG_TOP_K=8
RAG_RERANK_TOP_N=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SIMILARITY=0.35

# ---- GitHub sync ----
GITHUB_TOKEN=your-github-pat
GITHUB_USERNAME=ashishpokhrel

# ---- LinkedIn sync (manual export or provider) ----
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/ashishpokhrel

# ---- Rate limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60
