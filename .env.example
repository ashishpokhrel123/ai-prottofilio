# ============================================================
# AI PORTFOLIO — ENVIRONMENT
# Copy to .env and fill in. Validated at boot by
# apps/api/src/common/config/env.schema.ts — the API refuses to
# start on an invalid configuration rather than failing later.
# ============================================================

# ---- Runtime ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Public URL of the web app. Used for CORS and absolute links.
# Behind Caddy this is the proxy's address, not the container's port.
APP_URL=http://localhost

# Extra allowed browser origins, comma-separated. Unused in the Docker
# stack, where Caddy makes every request same-origin.
CORS_ORIGINS=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- Reverse proxy (Docker stack) ----
# Leave DOMAIN empty to serve plain HTTP on :80 — right for local use.
# Set it to a real hostname and Caddy provisions HTTPS automatically on
# first boot. The domain must already resolve to this host.
DOMAIN=
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443

# ---- Frontend → API ----
# Only used by `pnpm dev` on the host. In Docker, Caddy routes /api to the
# API container, so the browser is already same-origin.
API_URL=http://localhost:4000
# Set only if you serve the API on a different origin. Baked into the client
# bundle at build time, and requires the API's CORS_ORIGINS to match.
# NEXT_PUBLIC_API_URL=

# Chat transport. Defaults to SSE, which works everywhere including serverless.
# Set to "socket" to use the Socket.IO gateway instead — it needs a long-lived
# process, so only enable it on the container deploy. The client falls back to
# SSE if the socket can't connect.
# NEXT_PUBLIC_CHAT_TRANSPORT=socket

# ---- PostgreSQL (pgvector required) ----
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=ai_portfolio
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/ai_portfolio?schema=public
# Neon/Supabase only: unpooled endpoint used for migrations.
# DIRECT_URL=

# ---- Redis (optional) ----
# Without it the API ingests documents in-process: simpler to deploy, but
# jobs are lost on restart. Set it for durable background ingestion.
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# REQUIRED. Minimum 32 characters in production; boot fails otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d

# Seed credentials. ADMIN_PASSWORD must be 12+ characters — the seed refuses
# to run otherwise. Hashed with argon2id before storage.
ADMIN_EMAIL=admin@ashishpokhrel.dev
ADMIN_PASSWORD=

# Disables every admin auth guard. Development only; the env schema refuses
# to start a production build with this enabled.
AUTH_DEV_BYPASS=false

# The frontend half: skips the /admin login screen. Useless on its own — the
# console renders but every request still 401s unless AUTH_DEV_BYPASS is also
# true. `next build` sets NODE_ENV=production, which compiles this branch out,
# so it cannot take effect in a production bundle.
NEXT_PUBLIC_AUTH_DEV_BYPASS=false

# ---- Model provider ----
# Which adapter serves generation AND embeddings: "gemini" or "nvidia".
# Both at once, deliberately — the embedding side alone determines the vector
# column width, so mixing vendors is a footgun rather than a feature.
LLM_PROVIDER=gemini

# ---- Google Gemini ----
# Without a key the app still runs; the assistant returns a setup notice
# instead of generated answers.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- NVIDIA NIM ----
# Free key from https://build.nvidia.com — developer program, no card. The
# hosted endpoint is licensed for development, testing and evaluation only;
# production needs either NVIDIA AI Enterprise or a self-hosted deployment.
# The weights themselves are under the NVIDIA Open Model License, which does
# permit commercial self-hosting.
NVIDIA_API_KEY=

# OpenAI-compatible base URL. This is the one line that changes when moving
# off the hosted tier — a self-hosted NIM container or vLLM server speaks the
# same wire format, e.g. http://localhost:8000/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Nano is the default: a portfolio visitor feels first-token latency more than
# they benefit from deeper reasoning, and the RAG pipeline is doing the hard
# part. Swap for nvidia/nemotron-3-super-120b-a12b if the job-fit analyzer
# needs more headroom than the answers do.
NVIDIA_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Re-ranking has no OpenAI equivalent and is served from a DIFFERENT host:
# https://ai.api.nvidia.com/v1, not the integrate host above. Leave empty to
# use it. Pointing this at NVIDIA_BASE_URL returns "404 page not found".
NVIDIA_RERANK_BASE_URL=
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# ---- Embedding width ----
# Must match the vector(n) column. This is the setting that breaks things:
#   gemini text-embedding-004    → 768
#   nvidia/nemotron-3-embed-1b   → 2048  (not a Matryoshka model; cannot be
#                                         truncated without wrecking recall)
# Changing it means running apps/api/prisma/manual/switch-embedding-dimensions.sql
# and re-indexing. The env schema refuses to boot on a mismatch rather than
# letting it surface as an insert error mid-re-index.
EMBEDDING_DIMENSIONS=768

# ---- Retrieval tuning ----
RAG_TOP_K=8
RAG_RERANK_TOP_N=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SIMILARITY=0.35

# Second-stage ranking: "lexical" (local, free, instant) or "nvidia" (a
# cross-encoder round-trip per query — better relevance on paraphrased
# questions, ~200ms, one more request against the rate limit). Chosen
# independently of LLM_PROVIDER, and falls back to lexical on any failure.
RAG_RERANK_PROVIDER=lexical

# ---- GitHub sync ----
# Optional: raises rate limits and allows private repos.
GITHUB_TOKEN=
GITHUB_USERNAME=ashishpokhrel

# ---- Uploads ----
# The Docker stack overrides this to /data/uploads, backed by a named volume.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
# Optional override for the downloadable resume PDF.
# RESUME_PATH=knowledge/resume/ashish-pokhrel-resume.pdf

# ---- Rate limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60
# Chat is stricter: every request costs model tokens.
CHAT_RATE_LIMIT_TTL=60
CHAT_RATE_LIMIT_MAX=20
